    "happy": { "frames": "../frames/out/happy", "offsetX": 24, "loop": false, "next": "idle" },
    "surprised": { "frames": "../frames/out/surprised", "offsetX": 24, "loop": false, "next": "idle" },
    "worried": { "frames": "../frames/out/worried", "offsetX": 24, "loop": true },
    "talk": { "frames": "../frames/out/talk", "offsetX": 24, "loop": true },
    "drag": { "frames": "../frames/out/drag", "offsetX": 24, "loop": true },
