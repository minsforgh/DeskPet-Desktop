{
  "name": "@deskpet/plugin-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "definePlugin, PluginContext 타입, 테스트 하네스",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
